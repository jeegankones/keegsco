---
interface Props {
  index: number;
  title: string;
  tagline: string;
  year: string;
  tags: string[];
  status: 'live' | 'wip' | 'archived';
  href?: string;
}

const { index, title, tagline, year, tags, status, href } = Astro.props;

const statusLabel = { live: 'Live', wip: 'In progress', archived: 'Archived' }[
  status
];

const Tag = href ? 'a' : 'div';
const linkAttrs = href
  ? { href, target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<Tag
  {...linkAttrs}
  data-testid="project-row"
  class="group relative block rule transition-colors duration-500 hover:bg-[rgba(242,240,235,0.02)]"
>
  <div
    class="gutter grid grid-cols-12 items-baseline gap-x-6 py-8 md:py-10"
  >
    <!-- Index marker -->
    <span
      class="label col-span-2 tabular-nums text-faint transition-colors duration-500 group-hover:text-accent md:col-span-1"
    >
      {String(index).padStart(2, '0')}
    </span>

    <!-- Title + tagline -->
    <div class="col-span-10 md:col-span-6">
      <h3
        class="text-title font-semibold leading-[0.95] tracking-[-0.02em] transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-2"
      >
        {title}
      </h3>
      <p class="mt-3 max-w-md text-base leading-snug text-muted">
        {tagline}
      </p>
    </div>

    <!-- Tags -->
    <div class="col-span-8 col-start-3 mt-5 flex flex-wrap gap-x-4 gap-y-2 md:col-span-3 md:col-start-8 md:mt-0">
      {
        tags.map((t) => (
          <span class="label" style="letter-spacing:0.14em;">
            {t}
          </span>
        ))
      }
    </div>

    <!-- Year + arrow -->
    <div
      class="col-span-2 col-start-11 mt-5 flex items-baseline justify-end gap-3 md:col-span-2 md:col-start-11 md:mt-0"
    >
      <span class="label">{year}</span>
      {
        href && (
          <span
            aria-hidden="true"
            class="text-lg leading-none text-faint transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1 group-hover:text-accent"
          >
            ↗
          </span>
        )
      }
    </div>
  </div>

  <!-- Screen-reader status -->
  <span class="sr-only">{statusLabel}</span>
</Tag>
