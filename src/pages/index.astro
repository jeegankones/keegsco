---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.index - b.data.index);

const estYear = '2018';
const year = String(new Date().getFullYear());

const contact = [
  { label: 'GitHub', href: 'https://github.com/jeegankones', handle: '@jeegankones' },
  { label: 'Email', href: 'mailto:keegs112@gmail.com', handle: 'keegs112@gmail.com' },
];
---

<Base>
  <!-- ============================================================= -->
  <!--  Masthead                                                     -->
  <!-- ============================================================= -->
  <header class="gutter reveal flex items-center justify-between py-6" style="--i: 0;">
    <a href="/" class="label" style="color: var(--color-ink); letter-spacing: 0.14em;">
      keegs<span style="color: var(--color-accent);">.</span>co
    </a>
    <nav class="flex items-center gap-6 md:gap-10">
      <a href="#work" class="label transition-colors hover:text-[var(--color-ink)]">Work</a>
      <a href="#contact" class="label transition-colors hover:text-[var(--color-ink)]">Contact</a>
      <!-- Liveness, not availability: says a real person is still here,
           without a claim that goes stale when the site sits untouched. -->
      <span class="label hidden items-center gap-2 sm:inline-flex" style="color: var(--color-faint);">
        <span class="relative inline-flex h-1.5 w-1.5" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75" style="background: var(--color-accent);"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full" style="background: var(--color-accent);"></span>
        </span>
        Currently building
      </span>
    </nav>
  </header>

  <!-- ============================================================= -->
  <!--  Hero                                                         -->
  <!-- ============================================================= -->
  <section class="gutter relative pt-16 pb-24 md:pt-28 md:pb-36">
    <!-- Meta strip -->
    <div class="reveal mb-10 grid grid-cols-12 gap-x-6 border-t pt-4" style="--i: 1; border-color: var(--color-hairline);">
      <span class="label col-span-6 md:col-span-3">Software Engineer</span>
      <span class="label col-span-6 md:col-span-3" style="color: var(--color-faint);">Design &amp; Systems</span>
      <span class="label col-span-6 md:col-span-3 md:col-start-10 md:text-right" style="color: var(--color-faint);">Est. {estYear}</span>
    </div>

    <div class="grid grid-cols-12 items-end gap-x-6 gap-y-12">
      <!-- Name -->
      <h1 class="col-span-12 md:col-span-8">
        <span class="reveal block text-mega font-semibold uppercase leading-[0.82] tracking-[-0.03em]" style="--i: 2;">Keegan</span>
        <span class="reveal block text-mega font-semibold uppercase leading-[0.82] tracking-[-0.03em]" style="--i: 3;">
          Jones<span style="color: var(--color-accent);">.</span>
        </span>
      </h1>

      <!-- Statement -->
      <p class="reveal col-span-12 max-w-sm text-lg leading-snug text-muted md:col-span-4 md:pb-3" style="--i: 4; color: var(--color-muted);">
        I build software with an eye for how it looks and how it holds up. To
        me, engineering and design are one craft. This is a small, curated set
        of the things I&rsquo;ve most enjoyed making.
      </p>
    </div>
  </section>

  <!-- ============================================================= -->
  <!--  Selected work                                                -->
  <!-- ============================================================= -->
  <section id="work" class="pt-8">
    <div class="gutter flex items-baseline justify-between pb-6">
      <h2 class="label" style="color: var(--color-ink);">Selected Work</h2>
      <span
        class="label tabular-nums"
        style="color: var(--color-faint);"
        data-testid="project-count"
        data-count={projects.length}
      >
        [ {String(projects.length).padStart(2, '0')} ]
      </span>
    </div>

    <div>
      {
        projects.map((p) => (
          <ProjectRow
            index={p.data.index}
            title={p.data.title}
            tagline={p.data.tagline}
            year={p.data.year}
            tags={p.data.tags}
            status={p.data.status}
            href={p.data.repo ?? p.data.live}
          />
        ))
      }
      <div class="rule"></div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!--  Contact                                                      -->
  <!-- ============================================================= -->
  <section id="contact" class="gutter pt-28 pb-16 md:pt-40">
    <p class="label mb-8" style="color: var(--color-faint);">[ Contact ]</p>
    <div class="grid grid-cols-12 items-end gap-x-6 gap-y-12">
      <h2 class="col-span-12 text-display font-semibold uppercase leading-[0.9] tracking-[-0.02em] md:col-span-7">
        Let&rsquo;s make<br />something<span style="color: var(--color-accent);">.</span>
      </h2>

      <ul class="col-span-12 flex flex-col md:col-span-5 md:pb-2">
        {
          contact.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.href.startsWith('http') ? '_blank' : undefined}
                rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="group flex items-center justify-between border-t py-5 transition-colors duration-500 hover:text-[var(--color-accent)]"
                style="border-color: var(--color-hairline);"
              >
                <span class="text-2xl font-medium tracking-tight">{c.label}</span>
                <span class="label transition-colors group-hover:text-[var(--color-accent)]">
                  {c.handle}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============================================================= -->
  <!--  Colophon                                                     -->
  <!-- ============================================================= -->
  <footer class="gutter flex flex-col gap-3 border-t py-8 md:flex-row md:items-center md:justify-between" style="border-color: var(--color-hairline);">
    <span class="label" style="color: var(--color-faint);">© {year} Keegan Jones</span>
    <span class="label" style="color: var(--color-faint);">
      Built with Astro · Set in Archivo &amp; JetBrains Mono
    </span>
  </footer>
</Base>
